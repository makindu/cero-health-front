# CERO HEALTH — variables d'environnement PUBLIQUES du frontend.
# Tout ce qui est préfixé VITE_ est embarqué dans le JavaScript livré au navigateur :
# n'y mettez JAMAIS de mot de passe, de token, de clé secrète ni d'identifiant réel.
# Copiez ce fichier vers .env.local (ignoré par Git) et adaptez les valeurs.

VITE_APP_NAME="CERO HEALTH"
# Code applicatif dans le registre CERO ID (platform_applications.code)
VITE_APP_CODE=cero-health

# URL de base de chaque API (sans slash final). Laisser vide = API non configurée.
# Les chemins exacts (/api/v1, /api, ...) restent à confirmer pour chaque backend.
VITE_ID_CORE_API_URL=
VITE_UZISHA_API_URL=
VITE_HEALTH_API_URL=

VITE_API_TIMEOUT_MS=20000

# Mode aperçu : affiche l'interface sans connexion, sans appliquer les permissions.
# Réservé au développement et aux démonstrations ; un bandeau "Aperçu" est affiché.
VITE_PREVIEW_MODE=true

# Route /design-system (catalogue des composants). Par défaut : actif en développement seulement.
# VITE_ENABLE_DESIGN_SYSTEM=true

# Mode local : toutes les opérations métier fonctionnent SANS API, avec des données persistantes
# dans IndexedDB, uniquement sur CET appareil (aucune synchronisation, aucune requête vers les API).
# Un bandeau « MODE LOCAL » est affiché en permanence. Les permissions restent appliquées (rôles de démonstration).
# VITE_LOCAL_MODE=true
